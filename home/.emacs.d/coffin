;; Background requests (lsp-mode re-fetches rust-analyzer's own diagnostics after
;; every edit) get cancelled by rust-analyzer when another edit arrives first;
;; the newer request replaces them.  Don't report those; report anything else.
(defun coffin-rust--error-handler (method)
  (lambda (err)
    (unless (memq (lsp:json-error-code err)
                  '(-32800 -32801 -32802)) ; cancelled / content modified / server cancelled
      (lsp--warn "%s" (or (lsp--error-string err)
                          (format "%s Request has failed" method))))))

(setq lsp-default-create-error-handler-fn #'coffin-rust--error-handler)

;;; Starting, attaching, stopping

(defun coffin-rust--workspace-root (file)
  "Workspace root of FILE according to `cargo locate-project --workspace'."
  (let ((default-directory (file-name-directory file)))
    (with-temp-buffer
      (when (eq 0 (call-process "cargo" nil '(t nil) nil "locate-project"
                                "--workspace" "--message-format" "plain"))
        (file-name-directory (string-trim (buffer-string)))))))

(defun coffin-rust--running-workspace (&optional root)
  "Running rust-analyzer workspace for ROOT (or any, if ROOT is nil)."
  (when (featurep 'lsp-mode)
    (seq-find (lambda (ws)
                (and (eq (lsp--client-server-id (lsp--workspace-client ws))
                         'rust-analyzer)
                     (or (null root) (file-equal-p (lsp--workspace-root ws) root))))
              (lsp--session-workspaces (lsp-session)))))

(defun coffin-rust--connect (root)
  (let ((project-find-functions (list (lambda (_) (cons 'transient root))))
        (lsp-auto-guess-root t))
    (lsp)))

(defun coffin-rust--maybe-attach ()
  "Attach this buffer if rust-analyzer already runs for its workspace."
  (when (and buffer-file-name (coffin-rust--running-workspace))
    (let ((root (coffin-rust--workspace-root buffer-file-name)))
      (when (and root (coffin-rust--running-workspace root))
        (coffin-rust--connect root)))))

(defun coffin-rust-start ()
  "Start rust-analyzer for this buffer's Cargo workspace.
Open Rust buffers of the same workspace attach too."
  (interactive)
  (unless (and (derived-mode-p 'rust-mode) buffer-file-name)
    (user-error "Not a Rust file buffer"))
  (let ((root (or (coffin-rust--workspace-root buffer-file-name)
                  (user-error "cargo locate-project --workspace found no workspace"))))
    (coffin-rust--connect root)
    (dolist (buf (buffer-list))
      (with-current-buffer buf
        (when (and (derived-mode-p 'rust-mode) buffer-file-name
                   (not (bound-and-true-p lsp-mode))
                   (equal (coffin-rust--workspace-root buffer-file-name) root))
          (coffin-rust--connect root))))))

(defun coffin-rust-stop ()
  "Shut down rust-analyzer for this buffer's workspace."
  (interactive)
  (let ((ws (or (and (bound-and-true-p lsp-mode)
                     (seq-find (lambda (ws) (eq (lsp--client-server-id
                                                 (lsp--workspace-client ws))
                                                'rust-analyzer))
                               (lsp-workspaces)))
                (user-error "rust-analyzer isn't running for this buffer"))))
    (lsp-workspace-shutdown ws)))

;;; Completion: C-M-i only.  One blocking request per trigger; after that,
;;; typing narrows the list inside Emacs (lsp-mode's fuzzy scorer) and never
;;; asks the server again.  Backspacing past the trigger point starts a new
;;; request.

(setq company-idle-delay nil             ; never pop up by itself
      company-frontends                  ; no echo-area docs: those ask the server
      '(company-pseudo-tooltip-unless-just-one-frontend
        company-preview-if-just-one-frontend)
      company-transformers '(coffin-rust--no-methods-after-path
                             coffin-rust--members-first))

(defvar coffin-rust--last-timing nil)

(defun coffin-rust--completion-request (orig method params)
  "Make completion requests blocking and always \"complete\"."
  (if (not (equal method "textDocument/completion"))
      (funcall orig method params)
    (let* ((start (float-time))
           (resp (lsp-request method params)))  ; ignores input, no timeout
      (when (lsp-completion-list? resp)
        (setq resp (lsp-put resp :isIncomplete nil)))
      (setq coffin-rust--last-timing
            (list :server (- (float-time) start)
                  :items (length (if (lsp-completion-list? resp)
                                     (lsp:completion-list-items resp)
                                   resp))))
      resp)))

(defun coffin-rust--no-interrupt (orig &rest args)
  "Keep company from abandoning completion work when a key is pressed."
  (let ((non-essential nil))
    (apply orig args)))

(defun coffin-rust--time-complete (orig &rest args)
  (setq coffin-rust--last-timing nil)
  (let ((start (float-time)))
    (prog1 (apply orig args)
      (when coffin-rust--last-timing
        (plist-put coffin-rust--last-timing :total (- (float-time) start))))))

(with-eval-after-load 'lsp-mode
  (advice-add 'lsp-request-while-no-input :around #'coffin-rust--completion-request))
(with-eval-after-load 'company
  (advice-add 'company-capf :around #'coffin-rust--no-interrupt)
  (advice-add 'company-complete :around #'coffin-rust--time-complete))

(defun coffin-rust--no-methods-after-path (candidates)
  "After `Foo::', drop methods taking any form of self; keep associated fns.
rust-analyzer offers them because `Foo::method(&foo)' is valid Rust."
  (if (not (and (bound-and-true-p lsp-completion-mode)
                (save-excursion (skip-syntax-backward "w_") (looking-back "::" 2))))
      candidates
    (seq-remove (lambda (c) (eq (company-call-backend 'kind c) 'method)) candidates)))

(defun coffin-rust--members-first (candidates)
  "Stable-sort methods and fields ahead of everything else."
  (if (not (bound-and-true-p lsp-completion-mode))
      candidates
    (let (members others)
      (dolist (c candidates)
        (if (memq (company-call-backend 'kind c) '(method field))
            (push c members)
          (push c others)))
      (nconc (nreverse members) (nreverse others)))))

(defun coffin-rust-completion-timing ()
  "Show how long the last C-M-i completion took."
  (interactive)
  (if (not coffin-rust--last-timing)
      (message "No completion request timed yet")
    (let* ((server (* 1000 (plist-get coffin-rust--last-timing :server)))
           (total (* 1000 (or (plist-get coffin-rust--last-timing :total) 0))))
      (message "Last completion: %.0f ms total = %.0f ms server + %.0f ms Emacs (%d items)"
               total server (- total server)
               (plist-get coffin-rust--last-timing :items)))))

;;; Types

(defun coffin-rust--hover-signature (value)
  "The last code block before the docs in rust-analyzer hover markdown VALUE."
  (let ((head (car (split-string value "\n---\n")))
        (start 0) blocks)
    (while (string-match "```[a-z]*\n\\(\\(?:.\\|\n\\)*?\\)\n```" head start)
      (push (match-string 1 head) blocks)
      (setq start (match-end 0)))
    (or (car blocks) (string-trim head))))

(defun coffin-rust-type ()
  "Show the type or signature of the thing at point in the echo area."
  (interactive)
  (let* ((resp (lsp-request "textDocument/hover" (lsp--text-document-position-params)))
         (contents (and resp (lsp:hover-contents resp)))
         (value (and contents (if (stringp contents) contents
                                (lsp:markup-content-value contents)))))
    (if (not value)
        (message "No type information at point")
      (message "%s" (coffin-rust--hover-signature value)))))

;;; Diagnostics: a page (M-x coffin-rust-diagnostics) or an inline snapshot
;;; (M-x coffin-rust-diagnostics-show).  Neither updates by itself.

(defvar coffin-rust--progress (make-hash-table :test 'equal)
  "Workspace root -> plist of rust-analyzer progress state.")

(defun coffin-rust--progress (workspace params)
  "Record rust-analyzer's progress reports instead of showing them."
  (let* ((root (lsp--workspace-root workspace))
         (state (gethash root coffin-rust--progress))
         (token (format "%s" (lsp:progress-params-token params)))
         (value (lsp:progress-params-value params))
         (kind (lsp:work-done-progress-kind value))
         (active (or (plist-get state :active) (make-hash-table :test 'equal)))
         (check (string-match-p "flycheck" token)))
    (pcase kind
      ("begin"
       (puthash token (lsp:work-done-progress-begin-title value) active)
       (when check (setq state (plist-put state :check-running (current-time)))))
      ("end"
       (remhash token active)
       (when check
         (setq state (plist-put state :check-running nil))
         (setq state (plist-put state :check-finished (current-time))))))
    (puthash root (plist-put state :active active) coffin-rust--progress)))

(defun coffin-rust--workspace-or-error ()
  (or (and (bound-and-true-p lsp-mode)
           (seq-find (lambda (ws) (eq (lsp--client-server-id (lsp--workspace-client ws))
                                      'rust-analyzer))
                     (lsp-workspaces)))
      (user-error "rust-analyzer isn't running for this buffer")))

(defun coffin-rust--status-line (root)
  (let* ((state (gethash root coffin-rust--progress))
         (running (plist-get state :check-running))
         (finished (plist-get state :check-finished))
         (other (let (titles)
                  (maphash (lambda (tok title) (unless (string-match-p "flycheck" tok)
                                                 (push title titles)))
                           (or (plist-get state :active) (make-hash-table)))
                  titles)))
    (concat
     (cond (running (format "cargo check RUNNING since %s (results incomplete)"
                            (format-time-string "%T" running)))
           (finished (format "cargo check finished %s" (format-time-string "%T" finished)))
           (t "cargo check not run yet (runs on save)"))
     (when other (format " | rust-analyzer busy: %s" (string-join other ", ")))
     (format " | as of %s, g to refresh" (format-time-string "%T")))))

(defun coffin-rust--diagnostic-list (workspace)
  "Sorted list of (file line col severity source message) for WORKSPACE."
  (let (rows)
    (maphash
     (lambda (file diags)
       (dolist (d diags)
         (let ((start (lsp:range-start (lsp:diagnostic-range d))))
           (push (list file
                       (1+ (lsp:position-line start))
                       (1+ (lsp:position-character start))
                       (or (lsp:diagnostic-severity? d) 1)
                       (or (lsp:diagnostic-source? d) "?")
                       (lsp:diagnostic-message d))
                 rows))))
     (lsp--workspace-diagnostics workspace))
    (sort rows (lambda (a b) (or (string< (car a) (car b))
                                 (and (equal (car a) (car b))
                                      (< (cadr a) (cadr b))))))))

(defvar-local coffin-rust--diag-workspace nil)

(define-derived-mode coffin-rust--diagnostics-mode compilation-mode "Rust-Diags"
  "List of rust-analyzer diagnostics.  RET visits, g refreshes."
  ;; Don't scroll this page when visiting an entry; mark it with => instead.
  (setq-local compilation-context-lines t)
  (setq-local revert-buffer-function
              (lambda (&rest _) (coffin-rust--fill-diagnostics))))
(define-key coffin-rust--diagnostics-mode-map (kbd "g") #'revert-buffer)

(defun coffin-rust--fill-diagnostics ()
  (let* ((ws coffin-rust--diag-workspace)
         (root (lsp--workspace-root ws))
         (inhibit-read-only t))
    ;; Drop remembered file positions; they shift as files are edited, and
    ;; reusing them makes jumps land off by the lines added or removed.
    (compilation-forget-errors)
    (erase-buffer)
    (setq default-directory (file-name-as-directory root))
    (setq header-line-format (coffin-rust--status-line root))
    (let ((rows (coffin-rust--diagnostic-list ws)))
      (dolist (r rows)
        (pcase-let ((`(,file ,line ,col ,sev ,source ,msg) r))
          (insert (format "%s:%d:%d: %s: [%s] %s\n"
                          (file-relative-name file root) line col
                          (pcase sev (1 "error") (2 "warning") (3 "info") (_ "note"))
                          source
                          (replace-regexp-in-string "\n" "\n    " msg)))))
      (unless rows (insert "No diagnostics.\n")))
    (goto-char (point-min))
    (compilation-parse-errors (point-min) (point-max))))

(defun coffin-rust-diagnostics ()
  "Show rust-analyzer's current diagnostics for this workspace in a page."
  (interactive)
  (let ((ws (coffin-rust--workspace-or-error))
        (buf (get-buffer-create "*rust-diagnostics*")))
    (with-current-buffer buf
      (coffin-rust--diagnostics-mode)
      (setq coffin-rust--diag-workspace ws)
      (coffin-rust--fill-diagnostics))
    (setq next-error-last-buffer buf)
    (pop-to-buffer buf)))

(defun coffin-rust-diagnostics-hide ()
  "Remove the inline diagnostics snapshot."
  (interactive)
  (remove-overlays nil nil 'coffin-rust-diag t)
  (remove-hook 'after-change-functions #'coffin-rust--hide-on-edit t))

(defun coffin-rust--hide-on-edit (&rest _)
  (coffin-rust-diagnostics-hide))

(defun coffin-rust-diagnostics-show ()
  "Show a snapshot of this file's diagnostics inline; it clears on your next edit."
  (interactive)
  (coffin-rust-diagnostics-hide)
  (let ((diags (gethash (lsp--fix-path-casing buffer-file-name)
                        (lsp--workspace-diagnostics (coffin-rust--workspace-or-error)))))
    (dolist (d diags)
      (let* ((region (lsp--range-to-region (lsp:diagnostic-range d)))
             (face (if (eq (lsp:diagnostic-severity? d) 1) 'error 'warning))
             (beg (car region))
             (end (max (cdr region) (min (1+ beg) (line-end-position))))
             (ov (make-overlay beg end))
             (eol (make-overlay (save-excursion (goto-char beg) (line-end-position))
                                (save-excursion (goto-char beg) (line-end-position)))))
        (overlay-put ov 'coffin-rust-diag t)
        (overlay-put ov 'face `(:inherit ,face :underline t))
        (overlay-put eol 'coffin-rust-diag t)
        (overlay-put eol 'after-string
                     (propertize (concat "  <- " (car (split-string (lsp:diagnostic-message d) "\n")))
                                 'face face))))
    (add-hook 'after-change-functions #'coffin-rust--hide-on-edit nil t)
    (message "%d diagnostics shown; they clear on your next edit" (length diags))))

;;; All types in a file: a snapshot of rust-analyzer's type hints
;;; (M-x coffin-rust-types-show).  Clears on your next edit; never updates.

;; Lets rust-analyzer compute type hints.  With lsp-auto-configure nil,
;; lsp-mode never requests or shows them on its own.
(setq lsp-inlay-hint-enable t
      lsp-rust-analyzer-display-chaining-hints t           ; types in method chains
      lsp-rust-analyzer-closure-return-type-hints "always")

(defun coffin-rust-types-hide ()
  "Remove the inline types snapshot."
  (interactive)
  (remove-overlays nil nil 'coffin-rust-type t)
  (remove-hook 'after-change-functions #'coffin-rust--types-hide-on-edit t))

(defun coffin-rust--types-hide-on-edit (&rest _)
  (coffin-rust-types-hide))

(defun coffin-rust-types-show ()
  "Show the types rust-analyzer infers for this whole file, inline.
It's a snapshot: it clears on your next edit."
  (interactive)
  (coffin-rust--workspace-or-error)
  (coffin-rust-types-hide)
  (let ((hints (lsp-request "textDocument/inlayHint"
                            (list :textDocument (lsp--text-document-identifier)
                                  :range (list :start (lsp-point-to-position (point-min))
                                               :end (lsp-point-to-position (point-max)))))))
    (seq-doseq (hint hints)
      (let* ((label (lsp:inlay-hint-label hint))
             (text (if (stringp label) label
                     (mapconcat #'lsp:inlay-hint-label-part-value label "")))
             (text (concat (if (lsp:inlay-hint-padding-left? hint) " " "")
                           text
                           (if (lsp:inlay-hint-padding-right? hint) " " "")))
             (pos (lsp--position-to-point (lsp:inlay-hint-position hint)))
             (ov (make-overlay pos pos)))
        (overlay-put ov 'coffin-rust-type t)
        (overlay-put ov 'before-string (propertize text 'face 'lsp-inlay-hint-type-face))))
    (add-hook 'after-change-functions #'coffin-rust--types-hide-on-edit nil t)
    (message "%d types shown; they clear on your next edit" (length hints))))

;;; Tab / Shift+Tab in Rust, like VS Code.  The indent width is what cargo fmt
;;; uses for the file (tab_spaces / hard_tabs from `rustfmt --print-config').
;;;   Tab, blank line:  go to the indentation rust-mode computes for it; if the
;;;                     line is already indented that far, one more tab stop.
;;;   Tab, otherwise:   insert spaces at point up to the next tab stop
;;;                     (replacing a selection within one line).
;;;   Tab, multi-line selection:  indent every selected line one level.
;;;   Shift+Tab:        unindent the current or selected lines one level.

(defvar-local coffin-rust--indent nil "(WIDTH . HARD-TABS) for this buffer.")

(defun coffin-rust--indent-width ()
  "Indent width cargo fmt uses for this file (asked once per buffer)."
  (unless coffin-rust--indent
    (let ((file buffer-file-name) width hard)
      (when file
        (with-temp-buffer
          (let ((default-directory (file-name-directory file)))
            (when (eq 0 (call-process "rustfmt" nil '(t nil) nil
                                      "--print-config" "current" file))
              (goto-char (point-min))
              (when (re-search-forward "^tab_spaces = \\([0-9]+\\)$" nil t)
                (setq width (string-to-number (match-string 1))))
              (goto-char (point-min))
              (setq hard (re-search-forward "^hard_tabs = true$" nil t))))))
      (unless width
        (message "rustfmt config unavailable for this file; indenting by 4 spaces"))
      (setq coffin-rust--indent (cons (or width 4) (and hard t)))
      (setq-local rust-indent-offset (car coffin-rust--indent))
      (setq-local indent-tabs-mode (cdr coffin-rust--indent))
      (when hard (setq-local tab-width (car coffin-rust--indent)))))
  (car coffin-rust--indent))

(defun coffin-rust--insert-to-next-stop ()
  (let ((w (coffin-rust--indent-width))
        (col (current-column)))
    (if indent-tabs-mode
        (insert "\t")
      (insert (make-string (- (* w (1+ (/ col w))) col) ?\s)))))

(defun coffin-rust--blank-line-p ()
  (save-excursion (beginning-of-line) (looking-at-p "[ \t]*$")))

(defun coffin-rust--partial-line-region-p ()
  "Non-nil if the region lies within one line without covering all of it."
  (let ((beg (region-beginning)) (end (region-end)))
    (save-excursion
      (goto-char beg)
      (and (<= end (line-end-position))
           (not (and (bolp) (= end (line-end-position))))))))

(defun coffin-rust--shift (levels)
  "Move the current or selected lines LEVELS tab stops right (or left if negative)."
  (let* ((w (coffin-rust--indent-width))
         (deactivate-mark nil)
         (beg (if (use-region-p) (region-beginning) (point)))
         (end (if (use-region-p) (region-end) (point))))
    ;; Like VS Code, a selection ending at the start of a line leaves that line alone.
    (when (and (use-region-p) (> end beg)
               (save-excursion (goto-char end) (bolp)))
      (setq end (1- end)))
    (save-excursion
      (goto-char beg)
      (beginning-of-line)
      (let ((last (line-number-at-pos end)))
        (while (<= (line-number-at-pos) last)
          (let ((ind (current-indentation)))
            (unless (and (> levels 0) (coffin-rust--blank-line-p))
              (indent-line-to (if (> levels 0)
                                  (* w (1+ (/ ind w)))
                                (max 0 (* w (/ (1- ind) w)))))))
          (if (eobp) (setq last 0) (forward-line 1)))))))

(defun coffin-rust-tab ()
  "Indent like VS Code's Tab; see the comment above."
  (interactive)
  (coffin-rust--indent-width)
  (cond
   ((and (use-region-p) (not (coffin-rust--partial-line-region-p)))
    (coffin-rust--shift 1))
   ((use-region-p)
    (delete-region (region-beginning) (region-end))
    (coffin-rust--insert-to-next-stop))
   ((coffin-rust--blank-line-p)
    (let ((orig (current-indentation))
          (col (current-column)))
      (rust-mode-indent-line)
      (when (<= (current-indentation) orig)  ; already there: one more stop
        (indent-line-to orig)
        (move-to-column col)
        (coffin-rust--insert-to-next-stop))))
   (t (coffin-rust--insert-to-next-stop))))

(defun coffin-rust-backtab ()
  "Unindent the current or selected lines one level, like VS Code's Shift+Tab."
  (interactive)
  (coffin-rust--shift -1))

(with-eval-after-load 'rust-mode
  ;; Emacs 30 binds M-q in code buffers to prog-fill-reindent-defun, which
  ;; re-indents the whole function when point is on code.  Keep plain filling.
  (define-key rust-mode-map (kbd "M-q") #'fill-paragraph)
  (define-key rust-mode-map (kbd "TAB") #'coffin-rust-tab)
  (define-key rust-mode-map (kbd "<backtab>") #'coffin-rust-backtab))

;;; Formatting: C-c C-f (rust-mode's key).  With rust-analyzer attached it
;;; formats through rust-analyzer, which runs the project's rustfmt with the
;;; edition from Cargo.toml and the project's rustfmt.toml.  Without it, C-c C-f
;;; is rust-mode's plain rustfmt call.

(defun coffin-rust-format ()
  "Format this file with rustfmt through rust-analyzer."
  (interactive)
  (coffin-rust--workspace-or-error)
  (lsp-format-buffer))

(with-eval-after-load 'lsp-mode
  (define-key lsp-mode-map (kbd "C-c C-f") #'coffin-rust-format))

;;; Imports: M-x coffin-rust-add-imports.  For each name rust-analyzer can't
;;; resolve that has import suggestions, pick one or skip.  rust-analyzer writes
;;; the `use' where it belongs (merged/grouped per lsp-rust-analyzer-import-*).
;;; It rescans after each import, so a trait needed by a method on a type you
;;; just imported (e.g. std::io::Read for File::read_to_string) is offered too.

(defun coffin-rust--unresolved-names ()
  "(START . END) of each name rust-analyzer can't resolve, in file order.
Uses rust-analyzer's semantic tokens (not for highlighting, just to find them)."
  (let* ((ws (coffin-rust--workspace-or-error))
         (types (lsp:semantic-tokens-legend-token-types
                 (lsp:semantic-tokens-options-legend
                  (lsp:server-capabilities-semantic-tokens-provider?
                   (lsp--workspace-server-capabilities ws)))))
         (unresolved (seq-position types "unresolvedReference"))
         (data (plist-get (lsp-request "textDocument/semanticTokens/full"
                                       (list :textDocument (lsp--text-document-identifier)))
                          :data))
         (line 0) (col 0) (i 0) found)
    (while (< i (length data))
      (let ((dl (aref data i)) (dc (aref data (1+ i))))
        (setq col (if (zerop dl) (+ col dc) dc)
              line (+ line dl))
        (when (eql (aref data (+ i 3)) unresolved)
          (push (cons (lsp--position-to-point (list :line line :character col))
                      (lsp--position-to-point
                       (list :line line :character (+ col (aref data (+ i 2))))))
                found)))
      (setq i (+ i 5)))
    (nreverse found)))

(defun coffin-rust--import-actions (start end)
  (seq-filter (lambda (a) (string-prefix-p "Import `" (lsp:code-action-title a)))
              (lsp-request "textDocument/codeAction"
                           (list :textDocument (lsp--text-document-identifier)
                                 :range (list :start (lsp-point-to-position start)
                                              :end (lsp-point-to-position end))
                                 :context (list :diagnostics [])))))

;; cargo check (rustc) errors cover what the source scan can't see, e.g. a trait
;; needed by a method a macro calls (`write!' on a String needs fmt::Write).
(defun coffin-rust--check-errors ()
  "This file's errors from cargo check as (START END DIAGNOSTIC), START/END markers.
Nil if the buffer has unsaved changes (cargo check read the saved file).
Waits for a running check first; C-g stops waiting."
  (let ((ws (coffin-rust--workspace-or-error)))
    (when (plist-get (gethash (lsp--workspace-root ws) coffin-rust--progress) :check-running)
      (message "Waiting for cargo check to finish (C-g to skip its errors)...")
      (with-local-quit
        (while (plist-get (gethash (lsp--workspace-root ws) coffin-rust--progress)
                          :check-running)
          (accept-process-output nil 0.1)))
      (message nil))
    (unless (buffer-modified-p)
      (delq nil
            (mapcar (lambda (d)
                      (when (and (equal (lsp:diagnostic-source? d) "rustc")
                                 (eql (lsp:diagnostic-severity? d) 1))
                        (let ((region (lsp--range-to-region (lsp:diagnostic-range d))))
                          (list (copy-marker (car region)) (copy-marker (cdr region) t) d))))
                    (gethash (lsp--fix-path-casing buffer-file-name)
                             (lsp--workspace-diagnostics ws)))))))

(defun coffin-rust--error-import-actions (start end diagnostic)
  "Import suggestions for a cargo check DIAGNOSTIC now spanning START..END."
  (let ((d (plist-put (copy-sequence diagnostic) :range
                      (list :start (lsp-point-to-position start)
                            :end (lsp-point-to-position end)))))
    (seq-filter (lambda (a) (string-prefix-p "Import `" (lsp:code-action-title a)))
                (lsp-request "textDocument/codeAction"
                             (list :textDocument (lsp--text-document-identifier)
                                   :range (lsp:diagnostic-range d)
                                   :context (list :diagnostics (vector d)))))))

(defun coffin-rust--import-path (action)
  (let ((title (lsp:code-action-title action)))
    (string-match "`\\(.*\\)`" title)
    (match-string 1 title)))

(defun coffin-rust--next-import-question (asked check-errors)
  "Next name not in ASKED with import suggestions, as
\(NAME START END ACTIONS FROM-CHECK), or nil.  Unresolved names in the
source come first, then CHECK-ERRORS (see `coffin-rust--check-errors')."
  (let (no-suggestions)
    (or
     (seq-some
      (lambda (range)
        (let ((name (buffer-substring-no-properties (car range) (cdr range))))
          (unless (or (member name asked) (member name no-suggestions)
                      ;; `open' in `File::open' just repeats File's question
                      (save-excursion (goto-char (car range)) (looking-back "::" 2)))
            (let ((actions (coffin-rust--import-actions (car range) (cdr range))))
              (if actions
                  (list name (car range) (cdr range) actions nil)
                (push name no-suggestions)
                nil)))))
      (coffin-rust--unresolved-names))
     (seq-some
      (pcase-lambda (`(,start ,end ,diagnostic))
        (let* ((actions (coffin-rust--error-import-actions start end diagnostic))
               (name (and actions
                          (car (last (split-string
                                      (string-remove-suffix
                                       " as _" (coffin-rust--import-path (car actions)))
                                      "::"))))))
          (when (and name (not (member name asked)))
            (list name (marker-position start) (marker-position end) actions t))))
      check-errors))))

(defun coffin-rust-add-imports ()
  "Offer an import for each name in this file rust-analyzer can't resolve.
With the buffer saved, also for this file's cargo check errors that
rust-analyzer can fix with an import."
  (interactive)
  (let* ((unsaved (buffer-modified-p))
         (check-errors (coffin-rust--check-errors))
         (asked nil) (added 0) (home (point-marker)) question)
    (unwind-protect
        (while (setq question (coffin-rust--next-import-question asked check-errors))
          (pcase-let* ((`(,name ,start ,end ,actions ,from-check) question)
                       (paths (mapcar (lambda (a) (cons (coffin-rust--import-path a) a))
                                      actions))
                       (ov (make-overlay start end)))
            (push name asked)
            (overlay-put ov 'face 'highlight)
            (goto-char start)
            (unwind-protect
                (let ((pick (completing-read
                             (format "Import for `%s' (line %d%s; RET = %s): "
                                     name (line-number-at-pos)
                                     (if from-check ", from cargo check" "")
                                     (caar paths))
                             (append (mapcar #'car paths) '("skip"))
                             nil t nil nil (caar paths))))
                  (unless (equal pick "skip")
                    (lsp-execute-code-action (cdr (assoc pick paths)))
                    (setq added (1+ added))))
              (delete-overlay ov))))
      (goto-char home)
      (set-marker home nil)
      (dolist (e check-errors) (set-marker (nth 0 e) nil) (set-marker (nth 1 e) nil)))
    (message "%d import%s added%s" added (if (= added 1) "" "s")
             (if unsaved
                 " (unsaved changes: save and rerun to also cover errors only cargo check finds, like traits used by macros)"
               ""))))
